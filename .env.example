# Salin ke `.env` lalu isi key asli (`.env` sudah di-gitignore, jangan commit).
# Gateway otomatis memuat `.env` saat start (tanpa dependensi tambahan);
# environment yang sudah ada selalu menang atas isi `.env`.

# --- WAJIB untuk traffic luar: auth klien gateway (BEDA dari OPENCODE_API_KEY) ---
# Satu key:
# GATEWAY_API_KEY=sk-ganti-dengan-key-acak-panjang
# Multi-key / rotasi (koma-dipisah, ketiga var digabung bila diisi semua):
GATEWAY_API_KEYS=sk-key-utama,sk-key-cadangan
# GATEWAY_API_KEY=
# API_KEYS=

# --- Upstream OpenCode (server-to-server, jangan dibagikan ke klien) ---
# OPENCODE_API_KEY=
# OPENCODE_URL=https://opencode.ai/zen/v1/chat/completions
# OPENCODE_RESPONSES_URL=https://opencode.ai/zen/v1/responses
# OPENCODE_MODELS_URL=https://opencode.ai/zen/v1/models

# --- Operasional ---
# MONITOR_PASSWORD=ganti-password-kuat
# MONITOR_SECRET=isi-hex-acak-64-char-agar-cookie-tetap-valid-antar-restart
# ENFORCE_MONITOR_PASSWORD=true
# SCAN_GUARD_TRUST_PROXY=true  # WAJIB true bila di belakang reverse proxy/CDN
