# Salin ke `.env` lalu isi key asli (`.env` sudah di-gitignore, jangan commit).
# Gateway otomatis memuat `.env` saat start (tanpa dependensi tambahan);
# environment yang sudah ada selalu menang atas isi `.env`.

# --- WAJIB untuk traffic luar: auth klien gateway (BEDA dari OPENCODE_API_KEY) ---
# Satu key:
# GATEWAY_API_KEY=sk-ganti-dengan-key-acak-panjang
# Multi-key / rotasi (koma-dipisah, ketiga var digabung bila diisi semua):
GATEWAY_API_KEYS=sk-key-utama,sk-key-cadangan
# GATEWAY_API_KEY=
# API_KEYS=

# --- Upstream OpenCode (server-to-server, jangan dibagikan ke klien) ---
# OPENCODE_API_KEY=
# OPENCODE_URL=https://opencode.ai/zen/v1/chat/completions
# OPENCODE_RESPONSES_URL=https://opencode.ai/zen/v1/responses
# OPENCODE_MODELS_URL=https://opencode.ai/zen/v1/models

# --- Operasional ---
# MONITOR_PASSWORD=ganti-password-kuat
# MONITOR_SECRET=isi-hex-acak-64-char-agar-cookie-tetap-valid-antar-restart
# ENFORCE_MONITOR_PASSWORD=true
# SCAN_GUARD_TRUST_PROXY=true  # WAJIB true bila di belakang reverse proxy/CDN

# --- Outbound proxy SOCKS/HTTP (opsional, bisa juga via /monitor tanpa restart) ---
# Daftar awal proxy egress (koma-dipisah). Tanpa skema = socks5h (DNS via proxy,
# agar query AAAA api64.ipify.org diselesaikan di dalam container warp -> IPv6).
# WARP gratis + V6ONLY: tiap node tampil IPv6 UNIK (cek via api64.ipify.org atau
# Cloudflare trace warp=on). api.ipify.org itu IPv4-only -> selalu tampil IPv4
# shared 104.28.x.x yang SAMA di semua node (bukan bug, jangan dipakai menilai).
# Contoh pool warp-socks lokal (10 container di VM ini):
# OUTBOUND_PROXIES=socks5h://127.0.0.1:40001,socks5h://127.0.0.1:40002,socks5h://127.0.0.1:40003,socks5h://127.0.0.1:40004,socks5h://127.0.0.1:40005,socks5h://127.0.0.1:40006,socks5h://127.0.0.1:40007,socks5h://127.0.0.1:40008,socks5h://127.0.0.1:40009,socks5h://127.0.0.1:40010
# USE_PROXY=true            # saklar global (false = matikan semua proxy)
# PROXY_COOLDOWN=60         # detik proxy DOWN (transport gagal beruntun) di-skip;
#                           # blip tunggal hanya 15 dtk (toleransi warp flaky)
# PROXY_403_COOLDOWN=180    # detik proxy FLAGGED (egress IP ditolak upstream 403)
#                           # disisihkan. 403 = proxy SEHAT/test OK, yang di-flag IP-nya
# PROXY_COOLDOWN=60         # detik proxy gagal di-skip dari rotasi
# PROXY_TEST_TIMEOUT=10     # timeout tombol Test di dashboard
# PROXY_CONFIG_PATH=./proxies.json  # file persistensi konfigurasi dashboard
